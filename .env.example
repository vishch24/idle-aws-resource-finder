# Copy this file to .env and fill in real values.
# Add .env to .gitignore — never commit real credentials.
# On Beanstalk, set these under Configuration > Software > Environment properties.

# Flask
# Create SECRET_KEY using -- python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret
APP_PRINCIPAL_ARN=your-arn-here

# AWS credentials — used by boto3 inside the container
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
AWS_DEFAULT_REGION=<your-region>

# Database (RDS MySQL)
# Format: mysql+pymysql://username:password@rds-endpoint:3306/database_name
DATABASE_URL=mysql+pymysql://admin:password@your-rds-endpoint.rds.amazonaws.com:3306/idle_aws_finder

#Database (Local MySQL)
MYSQL_DATABASE=database_name
MYSQL_USER=appuser
MYSQL_PASSWORD=apppass
MYSQL_ROOT_PASSWORD=rootpass

# AWS scanning — set to today's rate
USD_TO_INR=88.0
